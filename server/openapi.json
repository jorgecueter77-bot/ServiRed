{
  "openapi": "3.0.3",
  "info": {
    "title": "ServiRed API",
    "version": "1.0.0",
    "description": "API del prototipo académico. Utilizar con datos ficticios."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/clientes": {
      "get": {
        "summary": "Consultar clientes",
        "responses": {
          "200": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cliente"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Registrar cliente",
        "responses": {
          "201": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "telefono": {
                    "type": "string",
                    "minLength": 7,
                    "maxLength": 22
                  }
                },
                "required": [
                  "nombre",
                  "telefono"
                ]
              },
              "example": {
                "nombre": "Cliente Demo",
                "telefono": "3000000001"
              }
            }
          }
        }
      }
    },
    "/tecnicos": {
      "get": {
        "summary": "Consultar técnicos",
        "responses": {
          "200": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tecnico"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/solicitudes": {
      "get": {
        "summary": "Consultar solicitudes y su estado",
        "responses": {
          "200": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Solicitud"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Registrar solicitud",
        "responses": {
          "201": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolicitudCreada"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cliente_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "descripcion": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 500
                  }
                },
                "required": [
                  "cliente_id",
                  "descripcion"
                ]
              },
              "example": {
                "cliente_id": 1,
                "descripcion": "Revisar conexión del equipo"
              }
            }
          }
        }
      }
    },
    "/ordenes": {
      "get": {
        "summary": "Consultar órdenes",
        "responses": {
          "200": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Orden"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "tecnico_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "summary": "Asignar técnico a una solicitud",
        "responses": {
          "201": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdenCreada"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto con el estado actual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "solicitud_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "tecnico_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "solicitud_id",
                  "tecnico_id"
                ]
              },
              "example": {
                "solicitud_id": 1,
                "tecnico_id": 1
              }
            }
          }
        }
      }
    },
    "/ordenes/{id}": {
      "patch": {
        "summary": "Avanzar estado de la orden",
        "responses": {
          "200": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "estado": {
                      "type": "string",
                      "enum": [
                        "Pendiente",
                        "En proceso",
                        "Finalizada"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "estado"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto con el estado actual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "estado": {
                    "type": "string",
                    "enum": [
                      "En proceso",
                      "Finalizada"
                    ]
                  }
                },
                "required": [
                  "estado"
                ]
              },
              "example": {
                "estado": "En proceso"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Cliente": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "nombre": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nombre",
          "telefono"
        ]
      },
      "Tecnico": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "nombre": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nombre"
        ]
      },
      "SolicitudCreada": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "cliente_id": {
            "type": "integer",
            "minimum": 1
          },
          "descripcion": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "Pendiente",
              "En proceso",
              "Finalizada"
            ]
          }
        },
        "required": [
          "id",
          "cliente_id",
          "descripcion",
          "estado"
        ]
      },
      "Solicitud": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "cliente_id": {
            "type": "integer",
            "minimum": 1
          },
          "descripcion": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "Pendiente",
              "En proceso",
              "Finalizada"
            ]
          },
          "creada": {
            "type": "string"
          },
          "cliente": {
            "type": "string"
          },
          "orden_id": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          }
        },
        "required": [
          "id",
          "cliente_id",
          "descripcion",
          "estado",
          "creada",
          "cliente",
          "orden_id"
        ]
      },
      "OrdenCreada": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "solicitud_id": {
            "type": "integer",
            "minimum": 1
          },
          "tecnico_id": {
            "type": "integer",
            "minimum": 1
          },
          "estado": {
            "type": "string",
            "enum": [
              "Pendiente",
              "En proceso",
              "Finalizada"
            ]
          }
        },
        "required": [
          "id",
          "solicitud_id",
          "tecnico_id",
          "estado"
        ]
      },
      "Orden": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "solicitud_id": {
            "type": "integer",
            "minimum": 1
          },
          "tecnico_id": {
            "type": "integer",
            "minimum": 1
          },
          "estado": {
            "type": "string",
            "enum": [
              "Pendiente",
              "En proceso",
              "Finalizada"
            ]
          },
          "tecnico": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "cliente": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "solicitud_id",
          "tecnico_id",
          "estado",
          "tecnico",
          "descripcion",
          "cliente"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "mensaje": {
            "type": "string"
          }
        },
        "required": [
          "mensaje"
        ]
      }
    }
  }
}
